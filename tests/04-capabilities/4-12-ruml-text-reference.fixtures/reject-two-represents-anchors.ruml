        "data": {
          "text_estg_1": {
            "title": "§ 1 EStG",
            "uri": "/akn/de/act/2024-01-01/estg#sec_1",
            "timestamp": "2026-10-09T00:00:00Z",
            "status": "inForce",
            "text": "§ 1 Steuerpflicht (1) Natürliche Personen, die im Inland einen Wohnsitz oder ihren gewöhnlichen Aufenthalt haben, sind unbeschränkt einkommensteuerpflichtig."
          },
          "text_estg_2": {
            "title": "§ 2 EStG",
            "uri": "/akn/de/act/2024-01-01/estg#sec_2",
            "timestamp": "2026-10-09T00:00:00Z",
            "status": "inForce",
            "text": "§ 2 Umfang der Besteuerung, Begriffsbestimmungen"
          }
        }
      }
    }
  ],
